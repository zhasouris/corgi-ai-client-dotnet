<Project>

  <!-- Settings shared by every project in the repo. Per-project files stay
       minimal and inherit from here. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- XML docs on by default (shippable libs). Test/sample projects turn this
         off in their own file — props are imported before the project body, so a
         condition on IsPackable here would not see it yet. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package metadata for the shippable libraries. Test/sample projects opt out
       with <IsPackable>false</IsPackable>. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <Authors>Zane Hasouris</Authors>
    <Product>CorgiAI.Client</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zhasouris/corgi-ai-client-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zhasouris/corgi-ai-client-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet;semantic-kernel;openai;llm;routing;corgi-ai-gateway</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
