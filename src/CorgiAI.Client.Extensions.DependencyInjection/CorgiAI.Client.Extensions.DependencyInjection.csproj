    <PackageId>CorgiAI.Client.Extensions.DependencyInjection</PackageId>
    <Description>Dependency-injection wiring for CorgiAI.Client: AddCorgiClient, keyed registration, IOptions binding.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CorgiAI.Client\CorgiAI.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0" />
  </ItemGroup>

</Project>
